# arrStack environment
# Copy this to /srv/arrstack/stack/.env and fill in values for your host.
# This file is committed to git; the actual .env is not.

# Host paths (drive roots — point at the mediaServer/ subdir on each drive)
ARR1_ROOT=/mnt/arr1/mediaServer
ARR2_ROOT=/mnt/arr2/mediaServer

# Timezone — see /usr/share/zoneinfo/, e.g. Europe/Dublin, America/New_York
TZ=Europe/Dublin

# Ports — host side
RADARR_PORT=7878
SONARR_PORT=8989
BAZARR_PORT=6767
PROWLARR_PORT=9696
SEERR_PORT=5055
TRANSMISSION_PORT=9091
TAUTULLI_PORT=8181
HOMEPAGE_PORT=3000
FLARESOLVERR_PORT=8191

# Phase 2.2 — Cloudflare Tunnel token (Zero Trust dashboard → Tunnels → Configure)
# Different from CF_API_TOKEN; this one is tunnel-specific.
CF_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# Phase 2.1 — Plex remote access via Caddy + Cloudflare DDNS
# CF_API_TOKEN: scoped to "Edit DNS records" on the relevant zone only.
# Create at: https://dash.cloudflare.com/profile/api-tokens
CF_API_TOKEN=your_cloudflare_api_token_here
PLEX_HOSTNAME=plex.example.com
PUBLIC_DOMAIN=example.com
