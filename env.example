# arrStack environment
# Copy this to /srv/arrstack/stack/.env and fill in values for your host.
# This file is committed to git; the actual .env is not.

# Host paths (drive roots — point at the mediaServer/ subdir on each drive)
ARR1_ROOT=/mnt/arr1/mediaServer
ARR2_ROOT=/mnt/arr2/mediaServer

# Timezone — see /usr/share/zoneinfo/, e.g. Europe/Dublin, America/New_York
TZ=Europe/Dublin

# Ports — host side
RADARR_PORT=7878
SONARR_PORT=8989
BAZARR_PORT=6767
PROWLARR_PORT=9696
SEERR_PORT=5055
TRANSMISSION_PORT=9091
TAUTULLI_PORT=8181
HOMEPAGE_PORT=3000
FLARESOLVERR_PORT=8191

# Phase 2 (Cloudflare Tunnel) — leave commented until cloudflared is reintroduced.
# CF_TOKEN=
